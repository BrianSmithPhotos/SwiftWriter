# Copy to .env and fill in. .env is gitignored - never commit real values.

# WordPress.com OAuth2 application, registered at https://developer.wordpress.com/apps/
WORDPRESS_CLIENT_ID=
WORDPRESS_CLIENT_SECRET=
# Must be a loopback address, and must match the app's Redirect URI at
# developer.wordpress.com/apps. A custom scheme cannot work for the CLI: nothing
# registers it, so the browser has nowhere to send the redirect and stops without
# changing the address bar. The port is read from this URL.
WORDPRESS_REDIRECT_URI=http://localhost:8722/callback

# Target site. Numeric blog ID or hostname.
WORDPRESS_SITE_ID=
